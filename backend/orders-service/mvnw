#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Start Up Batch script (Unix/Linux/macOS)
# ----------------------------------------------------------------------------
set -e

# Determine the directory of this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Locate JAVA_HOME
if [ -z "$JAVA_HOME" ]; then
  JAVA_HOME="$(java -XshowSettings:all -version 2>&1 | grep 'java.home' | awk '{print $NF}')"
fi

JAVA_EXEC="$JAVA_HOME/bin/java"
if [ ! -x "$JAVA_EXEC" ]; then
  JAVA_EXEC="java"
fi

WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"

# Download wrapper jar if it doesn't exist
if [ ! -f "$WRAPPER_JAR" ]; then
  DOWNLOAD_URL=$(grep 'wrapperUrl' "$WRAPPER_PROPS" | cut -d= -f2)
  echo "Downloading Maven Wrapper from $DOWNLOAD_URL"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_JAR" "$DOWNLOAD_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$WRAPPER_JAR" "$DOWNLOAD_URL"
  else
    echo "ERROR: Neither curl nor wget is available. Cannot download Maven Wrapper."
    exit 1
  fi
fi

exec "$JAVA_EXEC" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$SCRIPT_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
